# Copy to .env.local (git-ignored via *.local) and fill in your key.
# Vite exposes only VITE_-prefixed vars to the browser.
#
# NOTE: this key ships to the browser (the app calls Claude directly, no
# backend). Use your own key for local/demo only — do NOT commit it or deploy
# it publicly. For production, put the call behind a serverless proxy instead.
VITE_ANTHROPIC_API_KEY=sk-ant-...
